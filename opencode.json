{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "cloudflare": {
      "model": "{file:./models/small-model.txt}"
    },
    "explore": {
      "model": "{file:./models/small-model.txt}"
    },
    "expo": {
      "model": "{file:./models/small-model.txt}"
    },
    "github": {
      "model": "{file:./models/small-model.txt}"
    },
    "implement": {
      "model": "{file:./models/small-model.txt}"
    },
    "research": {
      "model": "{file:./models/small-model.txt}"
    },
    "review": {
      "model": "{file:./models/small-model.txt}"
    },
    "test": {
      "model": "{file:./models/small-model.txt}"
    },
    "title": {
      "model": "{file:./models/small-model.txt}"
    }
  },
  "mcp": {
    "servers": {
      "agent-device": {
        "command": [
          "agent-device",
          "mcp"
        ],
        "disabled": true,
        "type": "local"
      },
      "agentation": {
        "command": [
          "npx",
          "-y",
          "agentation-mcp",
          "server",
          "--port",
          "4747"
        ],
        "disabled": true,
        "type": "local"
      },
      "appfigures": {
        "command": [
          "npx",
          "-y",
          "@appfigures/cli",
          "mcp"
        ],
        "disabled": true,
        "type": "local"
      },
      "argent": {
        "command": [
          "argent",
          "mcp"
        ],
        "disabled": true,
        "type": "local"
      },
      "better-icons": {
        "command": [
          "npx",
          "-y",
          "better-icons"
        ],
        "disabled": true,
        "type": "local"
      },
      "brilliant": {
        "disabled": true,
        "type": "remote",
        "url": "http://127.0.0.1:3333/mcp"
      },
      "cloudflare": {
        "disabled": false,
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp"
      },
      "cloudflare-bindings": {
        "disabled": false,
        "type": "remote",
        "url": "https://bindings.mcp.cloudflare.com/mcp"
      },
      "cloudflare-builds": {
        "disabled": false,
        "type": "remote",
        "url": "https://builds.mcp.cloudflare.com/mcp"
      },
      "cloudflare-docs": {
        "disabled": false,
        "type": "remote",
        "url": "https://docs.mcp.cloudflare.com/mcp"
      },
      "cloudflare-observability": {
        "disabled": false,
        "type": "remote",
        "url": "https://observability.mcp.cloudflare.com/mcp"
      },
      "exa": {
        "disabled": false,
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp"
      },
      "excalidraw": {
        "command": [
          "npx",
          "-y",
          "mcp-excalidraw-server"
        ],
        "disabled": true,
        "type": "local"
      },
      "expo": {
        "disabled": false,
        "type": "remote",
        "url": "https://mcp.expo.dev/mcp"
      },
      "figma": {
        "disabled": false,
        "type": "remote",
        "url": "https://mcp.figma.com/mcp"
      },
      "gh_grep": {
        "disabled": false,
        "type": "remote",
        "url": "https://mcp.grep.app"
      },
      "lottiefiles-creator": {
        "command": [
          "npx",
          "-y",
          "@lottiefiles/creator-mcp@latest"
        ],
        "disabled": true,
        "type": "local"
      },
      "maestro": {
        "command": [
          "{env:HOME}/.maestro/bin/maestro",
          "mcp"
        ],
        "disabled": true,
        "environment": {
          "MAESTRO_CLI_ANALYSIS_NOTIFICATION_DISABLED": "true"
        },
        "type": "local"
      },
      "mobbin": {
        "disabled": false,
        "type": "remote",
        "url": "https://api.mobbin.com/mcp"
      },
      "notion": {
        "disabled": false,
        "type": "remote",
        "url": "https://mcp.notion.com/mcp"
      },
      "paper": {
        "disabled": true,
        "type": "remote",
        "url": "http://127.0.0.1:29979/mcp"
      },
      "quackback": {
        "disabled": false,
        "type": "remote",
        "url": "https://quackback.jestsee.com/api/mcp"
      },
      "pencil": {
        "command": [
          "/Users/jesica/.pencil/mcp/visual_studio_code/out/mcp-server-darwin-arm64",
          "--app",
          "visual_studio_code",
          "--agent",
          "openCodeCLI"
        ],
        "disabled": false,
        "type": "local"
      }
    },
    "pencil": {
      "command": [
        "/Users/jesica/.pencil/mcp/visual_studio_code/out/mcp-server-darwin-arm64",
        "--app",
        "visual_studio_code",
        "--agent",
        "openCodeCLI"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "model": "alibaba-token-plan/qwen3.8-max",
  "permissions": [
    {
      "action": "agent_device*",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "agentation*",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "appfigures*",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "argent*",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "better_icons*",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "cloudflare*",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "context7*",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "expo*",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "figma*",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "gh_grep*",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "github*",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "lottiefiles_creator*",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "maestro*",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "notion*",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "openchamber",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "pencil_*",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "skill",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "skill",
      "effect": "allow",
      "resource": "caveman"
    },
    {
      "action": "skill",
      "effect": "allow",
      "resource": "defuddle"
    },
    {
      "action": "skill",
      "effect": "allow",
      "resource": "find-skills"
    },
    {
      "action": "skill",
      "effect": "allow",
      "resource": "ponytail"
    },
    {
      "action": "skill",
      "effect": "allow",
      "resource": "ponytail-*"
    },
    {
      "action": "zeabur*",
      "effect": "deny",
      "resource": "*"
    }
  ],
  "plugins": []
}