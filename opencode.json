{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "cloudflare": {
      "model": "{file:./models/small-model.txt}"
    },
    "explore": {
      "model": "{file:./models/small-model.txt}"
    },
    "expo": {
      "model": "{file:./models/small-model.txt}"
    },
    "github": {
      "model": "{file:./models/small-model.txt}"
    },
    "implement": {
      "model": "{file:./models/small-model.txt}"
    },
    "research": {
      "model": "{file:./models/small-model.txt}"
    },
    "review": {
      "model": "{file:./models/small-model.txt}"
    },
    "test": {
      "model": "{file:./models/small-model.txt}"
    }
  },
  "mcp": {
    "agent-device": {
      "command": [
        "agent-device",
        "mcp"
      ],
      "enabled": false,
      "type": "local"
    },
    "agentation": {
      "command": [
        "npx",
        "-y",
        "agentation-mcp",
        "server",
        "--port",
        "4747"
      ],
      "enabled": false,
      "type": "local"
    },
    "appfigures": {
      "command": [
        "npx",
        "-y",
        "@appfigures/cli",
        "mcp"
      ],
      "enabled": false,
      "type": "local"
    },
    "argent": {
      "command": [
        "argent",
        "mcp"
      ],
      "enabled": false,
      "type": "local"
    },
    "better-icons": {
      "command": [
        "npx",
        "-y",
        "better-icons"
      ],
      "enabled": false,
      "type": "local"
    },
    "brilliant": {
      "enabled": false,
      "type": "remote",
      "url": "http://127.0.0.1:3333/mcp"
    },
    "cloudflare": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "cloudflare-bindings": {
      "enabled": true,
      "type": "remote",
      "url": "https://bindings.mcp.cloudflare.com/mcp"
    },
    "cloudflare-builds": {
      "enabled": true,
      "type": "remote",
      "url": "https://builds.mcp.cloudflare.com/mcp"
    },
    "cloudflare-docs": {
      "enabled": true,
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
    "cloudflare-observability": {
      "enabled": true,
      "type": "remote",
      "url": "https://observability.mcp.cloudflare.com/mcp"
    },
    "exa": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp"
    },
    "excalidraw": {
      "command": [
        "npx",
        "-y",
        "mcp-excalidraw-server"
      ],
      "enabled": false,
      "type": "local"
    },
    "expo": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.expo.dev/mcp"
    },
    "figma": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.figma.com/mcp"
    },
    "gh_grep": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "lottiefiles-creator": {
      "command": [
        "npx",
        "-y",
        "@lottiefiles/creator-mcp@latest"
      ],
      "enabled": false,
      "type": "local"
    },
    "maestro": {
      "command": [
        "{env:HOME}/.maestro/bin/maestro",
        "mcp"
      ],
      "enabled": false,
      "environment": {
        "MAESTRO_CLI_ANALYSIS_NOTIFICATION_DISABLED": "true"
      },
      "type": "local"
    },
    "mobbin": {
      "enabled": true,
      "type": "remote",
      "url": "https://api.mobbin.com/mcp"
    },
    "notion": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.notion.com/mcp"
    },
    "paper": {
      "enabled": false,
      "type": "remote",
      "url": "http://127.0.0.1:29979/mcp"
    },
    "quackback": {
      "enabled": true,
      "type": "remote",
      "url": "https://quackback.jestsee.com/api/mcp"
    },
    "pencil": {
      "command": [
        "/Users/jesica/.pencil/mcp/visual_studio_code/out/mcp-server-darwin-arm64",
        "--app",
        "visual_studio_code",
        "--agent",
        "openCodeCLI"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "model": "alibaba-token-plan/qwen3.8-max",
  "permission": {
    "agent-device*": "deny",
    "agentation*": "deny",
    "appfigures*": "deny",
    "argent*": "deny",
    "better-icons*": "deny",
    "cloudflare*": "deny",
    "context7*": "deny",
    "expo*": "deny",
    "figma*": "deny",
    "gh_grep*": "deny",
    "github*": "deny",
    "lottiefiles-creator*": "deny",
    "maestro*": "deny",
    "notion*": "deny",
    "openchamber": "deny",
    "pencil_*": "deny",
    "skill": {
      "*": "deny",
      "caveman": "allow",
      "defuddle": "allow",
      "find-skills": "allow",
      "ponytail": "allow",
      "ponytail-*": "allow"
    },
    "zeabur*": "deny"
  },
  "plugin": [
    "@dietrichgebert/ponytail@4.9.0"
  ],
  "small_model": "{file:./models/small-model.txt}"
}