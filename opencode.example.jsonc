{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "21st": {
      "enabled": true,
      "headers": {
        "x-api-key": "YOUR_21ST_API_KEY"
      },
      "oauth": false,
      "type": "remote",
      "url": "https://21st.dev/api/mcp"
    },
    "context7": {
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "YOUR_CONTEXT7_API_KEY"
      },
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "github": {
      "enabled": true,
      "headers": {
        "Authorization": "Bearer YOUR_GITHUB_MCP_TOKEN",
        "X-MCP-Readonly": "true"
      },
      "oauth": false,
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "shipstudio-preview": {
      "enabled": true,
      "type": "remote",
      "url": "https://YOUR_SHIPSTUDIO_PREVIEW_HOST/mcp"
    },
    "zeabur": {
      "command": [
        "npx",
        "-y",
        "@zeabur/mcp-server"
      ],
      "enabled": false,
      "environment": {
        "ZEABUR_TOKEN": "YOUR_ZEABUR_TOKEN"
      },
      "type": "local"
    }
  }
}
