{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "21st": {
        "headers": {
          "x-api-key": "YOUR_21ST_API_KEY"
        },
        "oauth": false,
        "type": "remote",
        "url": "https://21st.dev/api/mcp",
        "disabled": false
      },
      "context7": {
        "headers": {
          "CONTEXT7_API_KEY": "YOUR_CONTEXT7_API_KEY"
        },
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false
      },
      "github": {
        "headers": {
          "Authorization": "Bearer YOUR_GITHUB_MCP_TOKEN",
          "X-MCP-Readonly": "true"
        },
        "oauth": false,
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "disabled": false
      },
      "shipstudio-preview": {
        "type": "remote",
        "url": "https://YOUR_SHIPSTUDIO_PREVIEW_HOST/mcp",
        "disabled": false
      },
      "zeabur": {
        "command": [
          "npx",
          "-y",
          "@zeabur/mcp-server"
        ],
        "environment": {
          "ZEABUR_TOKEN": "YOUR_ZEABUR_TOKEN"
        },
        "type": "local",
        "disabled": true
      }
    }
  }
}
